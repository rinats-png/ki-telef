# Local SQLite. For PostgreSQL use .env.production.example and the db:postgres commands.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
ESTIMATED_LEAD_VALUE_EUR="250"

# auto: no complete keys -> visual mock; complete keys -> live in the live-data view.
# true: force mock. false: force live and report errors for incomplete credentials.
# All demo scenarios and browser voice tests keep Outlook actions local, regardless of this setting.
MOCK_MODE="auto"
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# AZURE_* and MICROSOFT_GRAPH_MOCK_MODE remain backward-compatible aliases.

VOICE_PROVIDER="retell"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
RETELL_API_KEY=""
RETELL_AGENT_ID=""
EMERGENCY_TECHNICIAN_PHONE=""
# Stores only the URL supplied by an authenticated provider; does not start recording.
STORE_CALL_RECORDINGS="true"

# Optional Vapi SIP alternative; not used by the selected Retell path.
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_SIP_URI=""
VAPI_WEBHOOK_SECRET=""
