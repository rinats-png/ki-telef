{
  "name": "storm-voice",
  "version": "1.0.0",
  "description": "Gesch\u00fctztes Disponenten-Dashboard mit Voice-AI-Webhooks f\u00fcr Storm GmbH",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:generate": "prisma generate",
    "db:seed": "node --import tsx scripts/seed.ts && node --import tsx scripts/seed-smart.ts",
    "admin:create": "node --import tsx scripts/admin-create.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "agent:export": "node --import tsx scripts/export-agent.ts",
    "db:seed:smart": "node --import tsx scripts/seed-smart.ts",
    "db:postgres:sync": "node --import tsx scripts/sync-postgres-schema.ts",
    "db:postgres:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "telephony:link": "node --import tsx scripts/link-twilio-number.ts",
    "telephony:reconcile": "node --import tsx scripts/reconcile-transfers.ts",
    "employees:import": "node --import tsx scripts/import-employees.ts",
    "test:postgres": "python3 scripts/check-postgres.py"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "retell-client-js-sdk": "^3.0.3",
    "retell-sdk": "^6.2.11",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true
}
